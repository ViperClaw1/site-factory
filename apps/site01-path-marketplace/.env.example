# Site identity
NEXT_PUBLIC_SITE_SLUG=path-marketplace
NEXT_PUBLIC_SITE_DOMAIN=marketplace.path-animation.com
BASE_URL=https://marketplace.path-animation.com

# Directus CMS
DIRECTUS_URL=https://cms.yourdomain.com
REVALIDATE_TOKEN=

# Supabase (commerce DB + Auth + Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hyperswitch (card + bank transfer payments)
NEXT_PUBLIC_HYPERSWITCH_PUBLISHABLE_KEY=
HYPERSWITCH_URL=https://hyperswitch.yourdomain.com
HYPERSWITCH_API_KEY=
HYPERSWITCH_WEBHOOK_SECRET=

# BTCPay Server (Bitcoin, ETH, USDT, USDC)
BTCPAY_URL=https://btcpay.yourdomain.com
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Formance (internal ledger)
FORMANCE_URL=https://formance.yourdomain.com
FORMANCE_LEDGER=marketplace
FORMANCE_API_KEY=

# Cloudflare R2 (digital asset storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=path-marketplace-digital
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Plausible (self-hosted analytics)
NEXT_PUBLIC_PLAUSIBLE_URL=https://analytics.yourdomain.com
